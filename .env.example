# 复制为 .env 后填写；已有的环境变量优先于本文件
# .env 已被 .gitignore 忽略，切勿提交

# 微信读书 Agent 网关 Key（只在服务端使用，绝不下发前端）
WEREAD_API_KEY=wrk-xxxxxxxx

# 监听端口（Caddy 反代到这个端口）
PORT=4321

# 站点名称（显示在页眉 / 接口返回）
SITE_NAME=流动的书

# 管理员站点口令：点击「管理员登录」时校验。
# 没设这项时 /api/login 会报错。建议 16 位以上随机串。
SITE_PASSWORD=改成你的强口令

# 会话签名密钥：用于签发管理员 Cookie（HMAC-SHA256）。
# 必须随机且保密，泄露会让他人伪造管理员身份。建议 32 字节十六进制。
SESSION_SECRET=改成 openssl rand -hex 32 生成的随机值

# ===== 智能解读层（AI 解读 / 每日导语）=====
# 三者都填才启用大模型；任一项缺失则自动走内置模板引擎（离线/演示可用）。
# 下面以「硅基流动 SiliconFlow」为例，任何 OpenAI 兼容端点均可（通义/DeepSeek/OpenAI…）。
# 注意 LLM_BASE_URL 填到 /v1 为止，代码会自动拼 /chat/completions。
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen3.5-35B-A3B

# 单次请求超时（毫秒）。推理模型建议 ≥60000；关闭思考后通常 1-5 秒返回。
LLM_TIMEOUT_MS=60000
# 是否开启推理模型的“思考”模式：默认关闭（enable_thinking:false，快且省 token）。
# 对 Qwen3.x 等推理模型，关闭后秒回；需要长思考可设为 1。
LLM_ENABLE_THINKING=0

